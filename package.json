{
  "name": "expogame-hub",
  "homepage": "https://pomareda-dev.github.io/expogame-hub/",
  "version": "1.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "test": "node --test tests/circuitoExpressPuzzle.test.mjs tests/circuitoExpressSettings.test.mjs",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "test:e2e:report": "playwright show-report",
    "build": "vite build",
    "build:tauri": "vite build --mode tauri",
    "dev:desktop": "tauri dev",
    "build:desktop": "npm run build:tauri && tauri build",
    "preview": "vite preview",
    "deploy": "npm run build && gh-pages -d dist"
  },
  "dependencies": {
    "lucide-react": "^0.577.0",
    "react": "^19.2.0",
    "react-dom": "^19.3.1",
    "react-router-dom": "^7.18.5"
  },
  "devDependencies": {
    "@playwright/test": "^1.65.1",
    "@tailwindcss/postcss": "^4.3.5",
    "@tauri-apps/cli": "^2.9.6",
    "@types/node": "^22.20.5",
    "@types/react": "^19.2.6",
    "@vitejs/plugin-react": "^5.0.0",
    "autoprefixer": "^10.4.22",
    "baseline-browser-mapping": "^2.11.37",
    "gh-pages": "^6.3.0",
    "postcss": "^8.5.33",
    "tailwindcss": "^4.3.5",
    "typescript": "~5.9.3",
    "vite": "^6.4.6",
    "vite-plugin-pwa": "^1.1.0"
  }
}
